<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Using solid background to prevent SDK contrast crashes. -->
    <style name="Theme.PixStreamo_m" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>

        <!-- Ensure solid window background for Cast SDK contrast checks -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
    </style>
</resources>
